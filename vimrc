set tabstop=4
set shiftwidth=4
set expandtab        " пробелы вместо табов
set autoindent

set hlsearch
set incsearch

set cursorline       " подсветка текущей строки
set nowrap

set clipboard=unnamed    " системный буфер обмена
set noswapfile
set hidden               " переключаться между буферами без сохранения

set backspace=indent,eol,start   " нормальный backspace в insert mode
set mouse=a                       " поддержка мыши

set scrolloff=8
syntax on
filetype plugin indent on